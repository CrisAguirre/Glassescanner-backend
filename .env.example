# Entorno: development | test | production
ENVIRONMENT=development

# Orígenes exactos del frontend (separados por coma). No usar "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://glassescanner.vercel.app,https://grupoprismavision.vercel.app
# Opcional: regex para previews controlados, p. ej. ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=

MAX_PHOTO_MB=5
RATE_LIMIT_PER_MINUTE=60
STORE_PHOTOS=false

# Genera una clave larga y aleatoria (mínimo 16 caracteres).
# En producción el arranque falla si está vacía o es un placeholder.
ADMIN_KEY=

# Mongo — completar en tu entorno (NO commitear el real):
MONGODB_URI=mongodb://localhost:27017/glassescanner
MONGODB_DB=glassescanner
